<?xml version="1.0"?>
<robot name="two_axis_gantry">

  <!-- ================= BASE LINK ================= -->
  <!-- A stationary base to mount the robot -->
  <link name="gantry_base_link">
    <visual>
      <origin xyz="-0.08 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.35 0.1 0.05" />
      </geometry>
      <material name="gray">
        <color rgba="0.5 0.5 0.5 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0.14 0 0" rpy="0 0 0" />
      <geometry>
        <box size="0.35 0.1 0.05" />
      </geometry>
    </collision>
  </link>

  <!-- ================= LINK 1 (X-Axis Carriage) ================= -->
  <link name="x_carriage">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <box size="0.08 0.08 0.08" />
      </geometry>
      <material name="blue">
        <color rgba="0 0 0.8 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <box size="0.08 0.08 0.08" />
      </geometry>
    </collision>
  </link>
  <link name='working_tip'>
    <visual>
      <origin xyz="0.0 0.0 -0.025" rpy="0.0 0.0 3.14" />
      <geometry>
        <box size="0.01 0.01 0.05" />
      </geometry>
    </visual>
  </link>
  <!-- Joint 1: Prismatic movement along the X-axis (1 0 0) -->
  <!-- Limits: -0.28 meters (-280mm) to 0.0 meters -->
  <joint name="joint_x" type="prismatic">
    <parent link="gantry_base_link" />
    <child link="x_carriage" />
    <origin xyz="0 0 0.025" rpy="0 0 0" />
    <axis xyz="1 0 0" />
    <limit lower="-0.28" upper="0.0" effort="100.0" velocity="1.0" />
  </joint>

  <!-- ================= LINK 2 (Z-Axis Shaft) ================= -->
  <link name="z_shaft">
    <visual>
      <origin xyz="0 0 0.05" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.04 0.09" />
      </geometry>
      <material name="green">
        <color rgba="0 0.8 0 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.05" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.04 0.15" />
      </geometry>
    </collision>
  </link>

  <!-- Joint 2: Prismatic movement along the Z-axis (0 0 1) -->
  <!-- Limits: -0.06 meters (-60mm) to 0.0 meters -->
  <joint name="joint_z" type="prismatic">
    <parent link="x_carriage" />
    <child link="z_shaft" />
    <origin xyz="0.06 -0.05 0.05" rpy="0 0 0" />
    <axis xyz="0 0 1" />
    <limit lower="-0.06" upper="0.0" effort="100.0" velocity="1.0" />
  </joint>

  <!-- ================= TOOL LINK ================= -->
  <!-- A thin cylinder acting as a "line" pointing in the Y direction -->
  <link name="gantry_tool_link">
    <visual>
      <origin xyz="0 -0.03 0.0" rpy="0 0 0" />
      <geometry>
        <box size="0.02 0.1 0.01" />
      </geometry>
      <material name="red">
        <color rgba="1 0 0 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.05" rpy="0 0 0" />
      <geometry>
        <box size="0.04 0.04 0.15" />
      </geometry>
    </collision>
  </link>
  <joint name="working_tip_tool" type="fixed">
    <parent link="gantry_tool_link" />
    <child link="working_tip" />
    <origin xyz="0.0 -0.07 0.05" rpy="0.0 0.0 0.0" />

  </joint>
  <!-- Fixed joint attaching the tool to the bottom of the Z-shaft -->
  <joint name="gantry_tool_joint" type="fixed">
    <parent link="z_shaft" />
    <child link="gantry_tool_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <!-- ================= ROS 2 CONTROL ================= -->
  <!-- This defines the interfaces for the controller manager to hook into -->
  <ros2_control name="HardwareSystem" type="system">
    <hardware>
      <!-- We use a mock component here so it can be tested without physical hardware -->
      <plugin>mock_components/GenericSystem</plugin>
    </hardware>

    <joint name="joint_x">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>

    <joint name="joint_z">
      <command_interface name="position" />
      <state_interface name="position" />
      <state_interface name="velocity" />
    </joint>
  </ros2_control>

</robot>