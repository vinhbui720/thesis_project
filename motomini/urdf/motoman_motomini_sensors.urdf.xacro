<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
    <link name="world_depth_camera_link">
        <visual>
            <geometry>
                <box size="0.05 0.05 0.05" />
            </geometry>
        </visual>
        <inertial>
            <mass value="0.1" />
            <origin xyz="0 0 0" />
            <inertia ixx="0.001" ixy="0" ixz="0"
                iyy="0.001" iyz="0"
                izz="0.001" />
        </inertial>
    </link>
    <link name="world_range_link">
        <visual>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <geometry>
                <box size="0.03 0.03 0.03" />
            </geometry>
        </visual>
        <!-- <collision>
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <geometry>
                <box size="0.03 0.03 0.03" />
            </geometry>
        </collision> -->
        <inertial>
            <mass value="0.05" />
            <origin xyz="0.0 0.0 0.0" rpy="0.0 0.0 0.0" />
            <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
                iyy="0.0001" iyz="0.0"
                izz="0.0001" />
        </inertial>
    </link>

    <joint name="world_range_joint" type="fixed">
        <parent link="workcell" />
        <child link="world_range_link" />
        <origin xyz="0.2 0.0 0.15" rpy="0 1.57142857143 0" />
    </joint>
    <joint name="world_depth_camera_joint" type="fixed">
        <parent link="workcell" />
        <child link="world_depth_camera_link" />
        <origin xyz="0.225 -0.225 0.245" rpy="0 3.14159 3.14159" />
    </joint>

    <gazebo reference="world_depth_camera_link">
        <sensor name="realsense_d435" type="rgbd_camera">
            <topic>camera</topic>

            <frame_id>world_depth_camera_link</frame_id>
            <ignition_frame_id>world_depth_camera_link</ignition_frame_id>

            <update_rate>30</update_rate>
            <camera name="d435">
                <horizontal_fov>1.5184</horizontal_fov>
                <vertical_fov>1.0123</vertical_fov>
                <image>
                    <width>640</width>
                    <height>480</height>
                    <format>R8G8B8</format>
                </image>
                <clip>
                    <near>0.2</near>
                    <far>10.0</far>
                </clip>
            </camera>
            <always_on>1</always_on>
            <visualize>true</visualize>
        </sensor>
    </gazebo>

    <gazebo reference="world_range_link">
        <sensor name="distance_sensor" type="gpu_lidar">
            <topic>distance_sensor/scan</topic>
            <update_rate>20</update_rate>
            <ray>
                <scan>
                    <horizontal>
                        <samples>1</samples>
                        <min_angle>0</min_angle>
                        <max_angle>0</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.05</min>
                    <max>5.0</max>
                </range>
            </ray>
            <always_on>true</always_on>
            <visualize>true</visualize>
        </sensor>
    </gazebo>
    <gazebo>
        <plugin filename="libignition-gazebo-sensors-system.so"
            name="ignition::gazebo::systems::Sensors">
            <render_engine>ogre2</render_engine>
        </plugin>
    </gazebo>
</robot>