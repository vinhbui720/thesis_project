<?xml version="1.0"?>
<robot name="rotaion_plate">

    <link name="plate_body">
        <visual>
            <geometry>
                <mesh
                    filename="package://thesis_project/motomini/meshes/plate/motomini_plate-plate_body.stl"
                    scale="0.001 0.001 0.001" />
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh
                    filename="package://thesis_project/motomini/meshes/plate/motomini_plate-plate_body.stl"
                    scale="0.001 0.001 0.001" />
            </geometry>
        </collision>
        <inertial>
            <mass value="1.0" />
            <origin xyz="0 0 0" />
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
        </inertial>
    </link>

    <link name="plate">
        <visual>
            <geometry>
                <mesh
                    filename="package://thesis_project/motomini/meshes/plate/motomini_plate-plate.stl"
                    scale="0.001 0.001 0.001" />
            </geometry>
        </visual>
        <collision>
            <geometry>
                <mesh
                    filename="package://thesis_project/motomini/meshes/plate/motomini_plate-plate.stl"
                    scale="0.001 0.001 0.001" />
            </geometry>
        </collision>
        <inertial>
            <mass value="1.0" />
            <origin xyz="0 0 0" />
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01" />
        </inertial>
    </link>

    <joint name="plate_rotation_joint" type="revolute">
        <parent link="plate_body" />
        <child link="plate" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit lower="-3.14" upper="3.14" effort="10" velocity="1" />
    </joint>


</robot>