<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dynamic_obstacle">
    <link name="obstacle_link">
        <visual>
            <origin xyz="0 0 0" rpy="0 1.57 0" />
            <geometry>
                <cylinder radius="0.01" length="0.1" />
            </geometry>
            <material name="red">
                <color rgba="1 0 0 0.8" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 1.57 0" />
            <geometry>
                <cylinder radius="0.01" length="0.1" />
            </geometry>
        </collision>
    </link>
</robot>