<?xml version="1.0" encoding="utf-8"?>
<robot name="motoman_motomini"
    xmlns:xacro="http://www.ros.org/wiki/xacro"
    xmlns:tesseract="http://ros.org/wiki/tesseract"
    tesseract:make_convex="true">

    <!-- ========= ARG FIRST ========= -->
    <xacro:arg name="controllers_file" default="" />
    <xacro:property name="controllers_file" value="$(arg controllers_file)" />
    <xacro:arg name="tool_type" default="gripper" />
    <xacro:property name="tool_type" value="$(arg tool_type)" />
    <!-- ========= INCLUDE ROBOT ========= -->
    <xacro:include filename="motoman_motomini.urdf" />
    <xacro:include filename="motoman_motomini_sensors.urdf.xacro" />
    <xacro:include filename="motoman_motomini_tool.xacro" />
    <xacro:include filename="2axis.urdf.xacro" />
    <!-- ========= TOOLS ========= -->
    <xacro:motomini_tool
        parent_link="tool0"
        tool_type="${tool_type}" />
    <!-- ========= WORLD FIX ========= -->
    <link name="world" />

    <joint name="world_to_workcell" type="fixed">
        <parent link="world" />
        <child link="workcell" />
        <origin xyz="0 0 0.068" rpy="0 0 0" />
    </joint>
    <joint name="world_to_gantry" type="fixed">
        <parent link="world" />
        <child link="gantry_base_link" />
        <origin xyz="-0.05 -0.3 0.1" rpy="0 0 3.14" />
    </joint>
    <gazebo reference="link_1_s">
        <turnGravityOff>true</turnGravityOff>
    </gazebo>

    <gazebo reference="link_2_l">
        <turnGravityOff>true</turnGravityOff>
    </gazebo>

    <gazebo reference="link_3_u">
        <turnGravityOff>true</turnGravityOff>
    </gazebo>

    <gazebo reference="link_4_r">
        <turnGravityOff>true</turnGravityOff>
    </gazebo>

    <gazebo reference="link_5_b">
        <turnGravityOff>true</turnGravityOff>
    </gazebo>

    <gazebo reference="link_6_t">
        <turnGravityOff>true</turnGravityOff>
    </gazebo>
    <!-- ================================================== -->
    <!-- =============== ROS2 CONTROL ===================== -->
    <!-- ================================================== -->

    <ros2_control name="MotomanFakeSystem" type="system">
        <hardware>
            <plugin>mock_components/GenericSystem</plugin>
        </hardware>

        <joint name="joint_1_s">
            <command_interface name="position" />
            <command_interface name="velocity" />
            <command_interface name="effort" />
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>

        <joint name="joint_2_l">
            <command_interface name="position" />
            <command_interface name="velocity" />
            <command_interface name="effort" />
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>

        <joint name="joint_3_u">
            <command_interface name="position" />
            <command_interface name="velocity" />
            <command_interface name="effort" />
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>

        <joint name="joint_4_r">
            <command_interface name="position" />
            <command_interface name="velocity" />
            <command_interface name="effort" />
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>

        <joint name="joint_5_b">
            <command_interface name="position" />
            <command_interface name="velocity" />
            <command_interface name="effort" />
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>

        <joint name="joint_6_t">
            <command_interface name="position" />
            <command_interface name="velocity" />
            <command_interface name="effort" />
            <state_interface name="position">
                <param name="initial_value">0.0</param>
            </state_interface>
            <state_interface name="velocity" />
            <state_interface name="effort" />
        </joint>
    </ros2_control>

    <!-- ================================================== -->
    <!-- ============== GAZEBO SETTINGS =================== -->
    <!-- ================================================== -->

    <gazebo>
        <gravity>false</gravity>
        <plugin
            filename="libgz_ros2_control-system.so"
            name="gz_ros2_control::GazeboSimROS2ControlPlugin">
            <parameters>${controllers_file}</parameters>
        </plugin>
    </gazebo>

</robot>