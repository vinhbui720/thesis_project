<?xml version="1.0"?>
<robot name="motoman_motomini" xmlns:tesseract="https://github.com/tesseract-robotics/tesseract"
    tesseract:make_convex="true">
    <link name="world" />
    <link name="base_link">
        <visual>
            <geometry>
                <mesh filename="package://robot_model/meshes/motomini/visual/base_link.stl" />
            </geometry>

        </visual>
        <collision>
            <geometry>
                <mesh
                    filename="package://robot_model/meshes/motomini/collision/base_link.stl" />
            </geometry>
        </collision>
    </link>
    <link name="link_1_s">
        <visual>
            <geometry>
                <mesh filename="package://robot_model/meshes/motomini/visual/link_1_s.stl" />
            </geometry>

        </visual>
        <collision>
            <geometry>
                <mesh filename="package://robot_model/meshes/motomini/collision/link_1_s.stl" />
            </geometry>
        </collision>
    </link>
    <link name="link_2_l">
        <visual>
            <geometry>
                <mesh filename="package://robot_model/meshes/motomini/visual/link_2_l.stl" />
            </geometry>

        </visual>
        <collision>
            <geometry>
                <mesh filename="package://robot_model/meshes/motomini/collision/link_2_l.stl" />
            </geometry>
        </collision>
    </link>
    <link name="link_3_u">
        <visual>
            <geometry>
                <mesh filename="package://robot_model/meshes/motomini/visual/link_3_u.stl" />
            </geometry>

        </visual>
        <collision>
            <geometry>
                <mesh filename="package://robot_model/meshes/motomini/collision/link_3_u.stl" />
            </geometry>
        </collision>
    </link>
    <link name="link_4_r">
        <visual>
            <geometry>
                <mesh filename="package://robot_model/meshes/motomini/visual/link_4_r.stl" />
            </geometry>

        </visual>
        <collision>
            <geometry>
                <mesh filename="package://robot_model/meshes/motomini/collision/link_4_r.stl" />
            </geometry>
        </collision>
    </link>
    <link name="link_5_b">
        <visual>
            <geometry>
                <mesh filename="package://robot_model/meshes/motomini/visual/link_5_b.stl" />
            </geometry>

        </visual>
        <collision>
            <geometry>
                <mesh filename="package://robot_model/meshes/motomini/collision/link_5_b.stl" />
            </geometry>
        </collision>
    </link>
    <link name="link_6_t">
        <visual>
            <geometry>
                <mesh filename="package://robot_model/meshes/motomini/visual/link_6_t.stl" />
            </geometry>

        </visual>
        <collision>
            <geometry>
                <mesh filename="package://robot_model/meshes/motomini/collision/link_6_t.stl" />
            </geometry>
        </collision>
    </link>
    <link name="tool0" />
    <!-- end of link list -->

    <!-- joint list -->
    <joint name="world_joint" type="fixed">
        <parent link="world" />
        <child link="base_link" />
        <origin xyz="0 0 0" rpy="0 0 0" />
    </joint>
    <joint name="joint_1_s" type="revolute">
        <parent link="base_link" />
        <child link="link_1_s" />
        <origin xyz="0 0 0.103" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit lower="-2.9670" upper="2.9670" effort="0.12" velocity="5.4977" />
    </joint>
    <joint name="joint_2_l" type="revolute">
        <parent link="link_1_s" />
        <child link="link_2_l" />
        <origin xyz="0.020 0 0" rpy="0 0 0" />
        <axis xyz="0 1 0" />
        <limit lower="-1.4835" upper="1.5707" effort="0.12" velocity="5.4977" />
    </joint>
    <joint name="joint_3_u" type="revolute">
        <parent link="link_2_l" />
        <child link="link_3_u" />
        <origin xyz="0 0 0.165" rpy="0 0 0" />
        <axis xyz="0 -1 0" />
        <limit lower="-0.8726" upper="1.5707" effort="0.12" velocity="7.3304" />
    </joint>
    <joint name="joint_4_r" type="revolute">
        <parent link="link_3_u" />
        <child link="link_4_r" />
        <origin xyz="0.165 0 0" rpy="0 0 0" />
        <axis xyz="-1 0 0" />
        <limit lower="-2.4434" upper="2.4434" effort="0.07" velocity="10.4719" />
    </joint>
    <joint name="joint_5_b" type="revolute">
        <parent link="link_4_r" />
        <child link="link_5_b" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <axis xyz="0 -1 0" />
        <limit lower="-0.5235" upper="3.6651" effort="0.07" velocity="10.4719" />
    </joint>
    <joint name="joint_6_t" type="revolute">
        <parent link="link_5_b" />
        <child link="link_6_t" />
        <origin xyz="0 0 0" rpy="0 0 0" />
        <axis xyz="0 0 1" />
        <limit lower="-6.2831" upper="6.2831" effort="0.07" velocity="10.4719" />
    </joint>
    <joint name="joint_6_t-tool0" type="fixed">
        <origin xyz="0 0 -0.040 " rpy="3.14159265 0 0" />
        <parent link="link_6_t" />
        <child link="tool0" />
    </joint>
    <!-- end of joint list -->

    <!-- ROS base_link to Robot Manufacturer World Coordinates transform -->
    <link name="base" />
    <joint name="base_link-base" type="fixed">
        <origin xyz="0 0 0.103" rpy="0 0 0" />
        <parent link="base_link" />
        <child link="base" />
    </joint>
</robot>